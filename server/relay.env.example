# OAuth client of type "Web application" from the Google Cloud console.
# The client must have this exact redirect URI registered:
#   https://screensaver.mkulik.eu/oauth/callback
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Public HTTPS base URL of this relay, without a trailing slash.
PUBLIC_BASE_URL=https://screensaver.mkulik.eu

# Google Photos Picker scope. Do not change unless Google changes it.
PHOTOS_SCOPE=https://www.googleapis.com/auth/photospicker.mediaitems.readonly

# How long the user has to finish signing in on their phone.
SESSION_TTL_SECONDS=900

# How long a finished session is kept so the TV can collect its tokens.
DELIVERY_TTL_SECONDS=300
