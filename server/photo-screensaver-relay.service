[Unit]
Description=Photo Gallery Screensaver OAuth relay
Documentation=https://github.com/michalkulik/photo-gallery-screensaver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=screensaver
Group=screensaver
WorkingDirectory=/opt/photo-screensaver
EnvironmentFile=/etc/photo-screensaver/relay.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/photo-screensaver/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 9037 --proxy-headers --forwarded-allow-ips=*
Restart=on-failure
RestartSec=3

# The service only needs to make outbound HTTPS calls and hold tokens in memory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
