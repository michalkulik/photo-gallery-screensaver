[Unit]
Description=Synology Photos daily album curator
Documentation=https://github.com/michalkulik/photo-gallery-screensaver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photocurator
Group=photocurator
WorkingDirectory=/opt/photo-curator
EnvironmentFile=/etc/photo-curator/curator.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CURATOR_STATE_DIR=/var/lib/photo-curator
ExecStart=/opt/photo-curator/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 9038 --proxy-headers --forwarded-allow-ips=*
Restart=on-failure
RestartSec=5

# The service needs to reach the NAS and keep its SQLite state.
StateDirectory=photo-curator
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
ReadWritePaths=/var/lib/photo-curator

[Install]
WantedBy=multi-user.target
