# Synology Photos daily album curator
#
# The service listens on port 9038. It only needs to be reachable from your LAN or through a
# reverse proxy; nothing here is required for the Android TV app to work.

# NAS address and account. The password may be left empty here and supplied through the web UI
# instead, which stores it in /var/lib/photo-curator/config.json (mode 0600).
SYNO_HOST=100.68.69.157
SYNO_PORT=5001
SYNO_ACCOUNT=michal
SYNO_PASSWORD=

# Set to true only when the certificate actually matches the address you connect to. A NAS
# reached by IP while its certificate is issued for a hostname needs this left at false.
SYNO_VERIFY_TLS=false

# The album to fill, and how many photos (one per day) it should hold.
CURATOR_ALBUM=ostatnie_najciekawsze
CURATOR_DAYS=90

# Hour of the day (server local time) at which the daily run happens.
CURATOR_RUN_HOUR=4

# Read photos from the shared space rather than the personal space.
CURATOR_SHARED_SPACE=true

# How far back the curator may reach when it cannot fill the album from the last CURATOR_DAYS.
CURATOR_MAX_WINDOW_DAYS=3650

# Set to true to compute a selection without touching the album.
CURATOR_DRY_RUN=false

LOG_LEVEL=INFO
